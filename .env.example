# Optional: defaults to the multilingual Arabic-capable model below.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Optional: for example, cpu or cuda.
# EMBEDDING_DEVICE=cpu

# Optional: use a long random value to make student ID hashes resistant to guessing.
# STUDENT_ID_HASH_SALT=replace-with-a-long-random-secret

# Optional: defaults to logs/grading.db
# GRADING_LOG_DB_PATH=logs/grading.db

# Optional Redis cache settings. Caching defaults to enabled; unavailable Redis fails open.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

# Optional degradation policy. Retries are additional attempts after the first failure.
FALLBACK_ENABLED=true
# FALLBACK_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
